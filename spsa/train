#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)
STATE="$SCRIPT_DIR/state.json"
ITERATIONS=500
MODE=train
DRY_RUN=false

die() {
    echo "error: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage:
  ./spsa/train [--iterations N]
  ./spsa/train --promote [--dry-run]

Tune for 500 additional iterations by default, checkpoint and push the state,
then launch a detached 1000-game SPRT against the promoted defaults.
EOF
}

while (( $# )); do
    case "$1" in
        --iterations)
            (( $# >= 2 )) || die "--iterations requires a value"
            ITERATIONS=$2
            shift 2
            ;;
        --iterations=*)
            ITERATIONS=${1#*=}
            shift
            ;;
        --promote)
            MODE=promote
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

case "$ITERATIONS" in
    ''|*[!0-9]*) die "iteration count must be a positive integer" ;;
esac
(( ITERATIONS > 0 )) || die "iteration count must be positive"
[[ $MODE == promote || $DRY_RUN == false ]] ||
    die "--dry-run requires --promote"

cd "$ROOT"
if [[ $MODE == promote && $DRY_RUN == true ]]; then
    exec "$SCRIPT_DIR/.internal/promote.py" --dry-run
fi
[[ $(git branch --show-current) == main ]] || die "run this command from branch main"
git ls-files --error-unmatch spsa/state.json >/dev/null 2>&1 ||
    die "spsa/state.json must be tracked"
git config user.name "Petter Wahlman"
git config user.email "petter@wahlman.no"

require_clean_except_state() {
    local unexpected
    unexpected=$(git diff HEAD --name-only -- . ':!spsa/state.json')
    [[ -z $unexpected ]] || {
        echo "error: unrelated tracked changes must be committed first:" >&2
        echo "$unexpected" >&2
        exit 1
    }
}

checkpoint_state() {
    local iteration branch
    iteration=$(jq -er '.k' "$STATE")
    [[ $(jq -r '.batch.complete // true' "$STATE") == true ]] ||
        die "refusing to checkpoint incomplete iteration $iteration"

    if git diff HEAD --quiet -- spsa/state.json; then
        echo "SPSA iteration $iteration is already committed"
        return
    fi

    branch="feature/spsa-k${iteration}-checkpoint"
    git show-ref --verify --quiet "refs/heads/$branch" &&
        die "branch already exists: $branch"

    git fetch origin
    git merge --ff-only origin/main
    git switch -c "$branch"
    git add spsa/state.json
    git commit -m "chore: checkpoint SPSA iteration $iteration"
    git fetch origin
    git rebase origin/main
    git switch main
    git merge --ff-only "$branch"
    git branch -d "$branch"
    git push origin main
}

promote_state() {
    local iteration branch
    iteration=$(jq -er '.k' "$STATE")
    [[ $(jq -r '.batch.complete // false' "$STATE") == true ]] ||
        die "cannot promote an incomplete SPSA batch"

    require_clean_except_state
    git diff HEAD --quiet -- spsa/state.json ||
        die "commit the SPSA checkpoint before promotion"
    branch="feature/spsa-k${iteration}-promotion"
    git show-ref --verify --quiet "refs/heads/$branch" &&
        die "branch already exists: $branch"

    git fetch origin
    git merge --ff-only origin/main
    git switch -c "$branch"
    "$SCRIPT_DIR/.internal/promote.py"
    python3 -m unittest discover -s spsa/.internal/tests -p 'test_*.py'
    git add src/config.hpp spsa/params.txt
    git commit -m "perf: promote SPSA iteration $iteration"
    git fetch origin
    git rebase origin/main
    git switch main
    git merge --ff-only "$branch"
    git branch -d "$branch"
    git push origin main
}

if [[ $MODE == promote ]]; then
    promote_state
    exit 0
fi

require_clean_except_state
current=$(jq -er '.k' "$STATE")
complete=$(jq -r '.batch.complete // true' "$STATE")
stored_target=$(jq -er '.batch.target_k // .k' "$STATE")

if [[ $complete == true ]]; then
    checkpoint_state
    target=$((current + ITERATIONS))
else
    target=$stored_target
    echo "Resuming unfinished SPSA batch at $current/$target"
fi

current=$(jq -er '.k' "$STATE")
if (( current < target )); then
    echo "Tuning SPSA from iteration $current to $target"
    "$SCRIPT_DIR/.internal/tune.py" --iterations "$((target - current))"
else
    "$SCRIPT_DIR/.internal/tune.py" --iterations 1
fi

current=$(jq -er '.k' "$STATE")
complete=$(jq -r '.batch.complete // false' "$STATE")
(( current == target )) || die "tuner stopped at iteration $current, expected $target"
[[ $complete == true ]] || die "SPSA batch at iteration $target is incomplete"

checkpoint_state

run="spsa-k${target}-vs-promoted-defaults"
echo "Launching detached 1000-game SPRT: $run"
"$SCRIPT_DIR/.internal/sprt.py" --run "$run"
