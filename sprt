#!/usr/bin/env python3

import argparse
import subprocess
import sys
from pathlib import Path

def main():
    parser = argparse.ArgumentParser(
        description='Run SPRT test for chess engine',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
Examples:
  ./sprt
  ./sprt --games 20
  ./sprt --candidate build/enyo --reference build/baseline --games 40
        '''
    )

    parser.add_argument('--candidate', default='build/enyo',
                        help='Candidate engine path (default: build/enyo)')
    parser.add_argument('--reference', default='../assets/engines/enyo_55b13aa',
                        help='Reference engine path (default: ../assets/engines/enyo_55b13aa)')
    parser.add_argument('--book', default='../assets/books/AntiDraw_V2.1/NBC_Openings_V2/NBC_V2_4mvs.epd',
                        help='Opening book path')
    parser.add_argument('--games', type=int, default=50000,
                        help='Number of games (default: 50000)')
    parser.add_argument('--tc', default='10+0.1',
                        help='Time control (default: 10+0.1)')
    parser.add_argument('--threads', type=int, default=1,
                        help='Threads per engine (default: 1)')
    parser.add_argument('--concurrency', type=int, default=1,
                        help='Concurrent games (default: 1)')

    args = parser.parse_args()

    # Validate files exist
    candidate = Path(args.candidate)
    reference = Path(args.reference)
    book = Path(args.book)

    if not candidate.exists():
        print(f"Error: Candidate engine not found: {args.candidate}", file=sys.stderr)
        sys.exit(1)

    if not reference.exists():
        print(f"Error: Reference engine not found: {args.reference}", file=sys.stderr)
        sys.exit(1)

    if not book.exists():
        print(f"Error: Opening book not found: {args.book}", file=sys.stderr)
        sys.exit(1)

    # Create logs directory
    Path('logs').mkdir(exist_ok=True)
    Path('logs/sprt.log').unlink(missing_ok=True)
    Path('logs/sprt.pgn').unlink(missing_ok=True)

    print(f"[ candidate: {args.candidate} vs reference: {args.reference} ]")
    print(f"[ openings: {args.book}, games: {args.games}, tc: {args.tc} ]")

    cmd = [
        'cutechess-cli',
        '-engine', 'name=candidate', 'proto=uci', 'restart=on', f'cmd={args.candidate}',
        '-engine', 'name=reference', 'proto=uci', 'restart=on', f'cmd={args.reference}',
        '-openings', f'file={args.book}', 'format=epd', 'order=random',
        '-concurrency', str(args.concurrency),
        '-ratinginterval', '2',
        '-games', str(args.games),
        '-pgnout', 'logs/sprt.pgn',
        '-repeat',
        '-each', f'tc={args.tc}',
        '-recover',
        '-sprt', 'elo0=0', 'elo1=10', 'alpha=0.05', 'beta=0.05'
    ]

    # Run with tee to logs/sprt.log
    with open('logs/sprt.log', 'w') as logfile:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in proc.stdout:
            print(line, end='')
            logfile.write(line)
            logfile.flush()
        proc.wait()
        sys.exit(proc.returncode)

if __name__ == '__main__':
    main()
